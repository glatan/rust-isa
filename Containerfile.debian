FROM docker.io/library/debian:trixie-slim@sha256:4876fdea29cac1a33a3195f1eb1952feb1fca7dd6dd00be3e2f1879cf20d34d2

ENV DEBIAN_FRONTEND=noninteractive

# Cross GNU toolchains for every native test target. The extra libc packages
# provide the dynamic loader and shared libraries that QEMU needs with -L.
RUN dpkg --add-architecture i386 \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        gnupg \
        lsb-release \
        xz-utils \
        unzip \
        make \
        python3 \
        build-essential \
        pkg-config \
        file \
        libc6:i386 \
        qemu-user-static \
        gcc-i686-linux-gnu \
        libc6-dev-i386-cross \
        libc6-i386-cross \
        gcc-aarch64-linux-gnu \
        libc6-dev-arm64-cross \
        libc6-arm64-cross \
        gcc-arm-linux-gnueabihf \
        libc6-dev-armhf-cross \
        libc6-armhf-cross \
        gcc-powerpc64le-linux-gnu \
        libc6-dev-ppc64el-cross \
        libc6-ppc64el-cross \
        gcc-s390x-linux-gnu \
        libc6-dev-s390x-cross \
        libc6-s390x-cross \
        gcc-mips64-linux-gnuabi64 \
        libc6-dev-mips64-cross \
        libc6-mips64-cross \
        gcc-riscv64-linux-gnu \
        libc6-dev-riscv64-cross \
        libc6-riscv64-cross \
        gcc-loongarch64-linux-gnu \
        libc6-dev-loong64-cross \
        libc6-loong64-cross \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Keep the LLVM major version aligned with the main image. Debian's 23.x
# package may have a different patch release than Arch's 23.1.3.
# The upstream llvm.sh script and apt.llvm.org repository are not hash-pinned.
RUN curl -fsSL https://apt.llvm.org/llvm.sh -o /tmp/llvm.sh \
    && bash /tmp/llvm.sh 23 \
    && for tool in clang clang++ llvm-ar llvm-objdump llvm-mc llvm-nm llvm-link llvm-dis opt ld.lld lld; do \
        test -x "/usr/bin/$tool-23"; \
        ln -sf "/usr/bin/$tool-23" "/usr/local/bin/$tool"; \
    done \
    && rm -f /tmp/llvm.sh \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

ENV RUSTUP_HOME=/root/.rustup \
    CARGO_HOME=/root/.cargo \
    PATH=/root/.cargo/bin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin \
    CARGO_TARGET_WASM32_WASIP1_RUNNER=wasmtime \
    CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_RUNNER=qemu-aarch64-static \
    CARGO_TARGET_ARMV7_UNKNOWN_LINUX_GNUEABIHF_RUNNER=qemu-arm-static \
    CARGO_TARGET_RISCV64GC_UNKNOWN_LINUX_GNU_RUNNER=qemu-riscv64-static \
    CARGO_TARGET_LOONGARCH64_UNKNOWN_LINUX_GNU_RUNNER=qemu-loongarch64-static \
    CARGO_TARGET_S390X_UNKNOWN_LINUX_GNU_RUNNER=qemu-s390x-static \
    CARGO_TARGET_POWERPC64LE_UNKNOWN_LINUX_GNU_RUNNER=qemu-ppc64le-static \
    CARGO_TARGET_MIPS64_UNKNOWN_LINUX_GNUABI64_RUNNER=qemu-mips64-static

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs -o /tmp/rustup.sh \
    && sh /tmp/rustup.sh -y --default-toolchain 1.99.1 --profile minimal \
    && rustup component add rust-src rustfmt \
    && rustup target add wasm32-wasip1 wasm32-unknown-unknown \
    && rm -f /tmp/rustup.sh

RUN curl -fsSL -o /tmp/nextest.tar.gz https://get.nexte.st/0.9.148/linux \
    && echo "223ba936714cc861a9cdedad5a8eb664dfdd69d6fbdf6cea6aa8184f523290dc  /tmp/nextest.tar.gz" \
        | sha256sum -c - \
    && tar -xzf /tmp/nextest.tar.gz -C /usr/local/bin \
    && rm -f /tmp/nextest.tar.gz

RUN curl -fsSL -o /tmp/binaryen.tar.gz \
        https://github.com/WebAssembly/binaryen/releases/download/version_130/binaryen-version_130-x86_64-linux.tar.gz \
    && echo "0a18362361ad05465118cd8eeb72edaeec89de6894bc283576ef4e07aa3babcc  /tmp/binaryen.tar.gz" \
        | sha256sum -c - \
    && tar -xzf /tmp/binaryen.tar.gz -C /opt \
    && ln -sf /opt/binaryen-version_130/bin/wasm-opt /usr/local/bin/wasm-opt \
    && rm -f /tmp/binaryen.tar.gz

RUN curl -fsSL -o /tmp/wabt.tar.gz \
        https://github.com/WebAssembly/wabt/releases/download/1.0.42/wabt-1.0.42-linux-x64.tar.gz \
    && echo "84895407a6bbb80e918f33b16b2fb2206021c150b6bc9ff6f761263a745ab131  /tmp/wabt.tar.gz" \
        | sha256sum -c - \
    && tar -xzf /tmp/wabt.tar.gz -C /opt \
    && ln -sf /opt/wabt-1.0.42/bin/wasm2wat /usr/local/bin/wasm2wat \
    && ln -sf /opt/wabt-1.0.42/bin/wat2wasm /usr/local/bin/wat2wasm \
    && rm -f /tmp/wabt.tar.gz

RUN curl -fsSL -o /tmp/wasmtime.tar.xz \
        https://github.com/bytecodealliance/wasmtime/releases/download/v49.0.2/wasmtime-v49.0.2-x86_64-linux.tar.xz \
    && echo "a4d6e9e3a5a60f527cf7793d674c48930c80c2e8977995b8a275cad3254b9322  /tmp/wasmtime.tar.xz" \
        | sha256sum -c - \
    && tar -xJf /tmp/wasmtime.tar.xz -C /tmp \
    && install -m 755 /tmp/wasmtime-v49.0.2-x86_64-linux/wasmtime /usr/local/bin/wasmtime \
    && rm -rf /tmp/wasmtime.tar.xz /tmp/wasmtime-v49.0.2-x86_64-linux

RUN curl -fsSL -o /tmp/dprint.zip \
        https://github.com/dprint/dprint/releases/download/0.61.1/dprint-x86_64-unknown-linux-gnu.zip \
    && echo "c33d901d2f5b81af680bce50902e7193e6c169f4f2dd6e1d41d3c5a96d70ecb4  /tmp/dprint.zip" \
        | sha256sum -c - \
    && python3 -m zipfile -e /tmp/dprint.zip /usr/local/bin \
    && chmod +x /usr/local/bin/dprint \
    && rm -f /tmp/dprint.zip

# Intel SDE is kept inside the image so tests do not depend on a host mount.
RUN curl -fL -o /tmp/sde.tar.xz \
        https://downloadmirror.intel.com/924984/sde-external-10.13.1-2026-07-28-lin.tar.xz \
    && echo "94E97D623FEC54385686E1E7BA65EBC9941748C05EE451423948334892BF2B50  /tmp/sde.tar.xz" \
        | sha256sum -c - \
    && mkdir -p /opt/sde \
    && tar -xJf /tmp/sde.tar.xz -C /opt/sde --strip-components=1 \
    && rm -f /tmp/sde.tar.xz

COPY dprint.json /tmp/dprint.json

# Preload the pinned dprint plugins so formatting does not need network access
# after the image is built.
RUN cd /tmp \
    && dprint output-file-paths > /dev/null \
    && test -d /root/.cache/dprint

WORKDIR /src

RUN rustc --version \
    && cargo --version \
    && dprint --version \
    && clang --version \
    && llvm-ar --version \
    && llvm-mc --version \
    && llvm-objdump --version \
    && ld.lld --version \
    && test -d "$(rustc --print sysroot)/lib/rustlib/src/rust" \
    && cargo nextest --version \
    && wasm-opt --version \
    && wasm2wat --version \
    && wasmtime --version \
    && test -x /usr/bin/qemu-i386-static \
    && test -x /usr/bin/qemu-aarch64-static \
    && test -x /usr/bin/qemu-arm-static \
    && test -x /usr/bin/qemu-riscv64-static \
    && test -x /usr/bin/qemu-loongarch64-static \
    && test -x /usr/bin/qemu-s390x-static \
    && test -x /usr/bin/qemu-ppc64le-static \
    && test -x /usr/bin/qemu-mips64-static \
    && test -x /opt/sde/sde64 \
    && test -x /opt/sde/sde \
    && test -e /lib/ld-linux.so.2 \
    && for c in \
        i686-linux-gnu-gcc \
        aarch64-linux-gnu-gcc \
        arm-linux-gnueabihf-gcc \
        powerpc64le-linux-gnu-gcc \
        s390x-linux-gnu-gcc \
        mips64-linux-gnuabi64-gcc \
        riscv64-linux-gnu-gcc \
        loongarch64-linux-gnu-gcc; do \
        command -v "$c" > /dev/null; \
    done \
    && for d in \
        /usr/i686-linux-gnu \
        /usr/aarch64-linux-gnu \
        /usr/arm-linux-gnueabihf \
        /usr/powerpc64le-linux-gnu \
        /usr/s390x-linux-gnu \
        /usr/mips64-linux-gnuabi64 \
        /usr/riscv64-linux-gnu \
        /usr/loongarch64-linux-gnu; do \
        test -e "$d/lib/libc.so.6"; \
    done
