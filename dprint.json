{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "includes": [
    "**/*.md",
    "**/*.json",
    "**/*.toml",
    "**/Dockerfile",
    "**/Containerfile"
  ],
  "excludes": [
    "**/target/**",
    "**/target-nested/**",
    "**/.git/**",
    ".local/**",
    "**/node_modules/**",
    "tools/upstream/**/LICENSE*"
  ],
  "plugins": [
    "https://plugins.dprint.dev/markdown-0.27.0.wasm",
    "https://plugins.dprint.dev/json-0.25.2.wasm",
    "https://plugins.dprint.dev/toml-0.9.0.wasm",
    "https://plugins.dprint.dev/dockerfile-0.7.0.wasm"
  ],
  "markdown": {
    "lineWidth": 100,
    "textWrap": "never"
  },
  "json": {
    "indentWidth": 2
  },
  "toml": {
    "indentWidth": 2
  },
  "dockerfile": {}
}
